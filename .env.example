# Copy to `.env` and uncomment the block that matches your environment.
# See docs/DEPLOYMENT.md for PythonAnywhere vs VPS/Docker details.

# =============================================================================
# Local development (default)
# =============================================================================
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_CSRF_TRUSTED_ORIGINS=
PUBLIC_WEBSITE_BASE_URL=
ADMIN_NOTIFICATION_EMAILS=
DASHBOARD_MAX_UPLOAD_MB=10
DJANGO_SECURE_SSL_REDIRECT=False

# Email (optional locally — console backend is default when DEBUG=True)
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=True
# DJANGO_DEFAULT_FROM_EMAIL=noreply@example.com

# =============================================================================
# PythonAnywhere (staging / test deploy with SQLite)
# Replace YOURUSER and paths with your account paths.
# =============================================================================
# DJANGO_SECRET_KEY=<long-random-secret>
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=YOURUSER.pythonanywhere.com
# DATABASE_URL=sqlite:////home/YOURUSER/bymer-be/db.sqlite3
# DJANGO_CORS_ALLOWED_ORIGINS=https://YOURUSER.pythonanywhere.com,https://www.your-frontend.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://YOURUSER.pythonanywhere.com
# PUBLIC_WEBSITE_BASE_URL=https://www.your-frontend.com
# ADMIN_NOTIFICATION_EMAILS=you@example.com
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_DEFAULT_FROM_EMAIL=noreply@example.com
# DJANGO_SECURE_SSL_REDIRECT=False

# =============================================================================
# VPS / Docker production (PostgreSQL)
# =============================================================================
# DJANGO_SECRET_KEY=<long-random-secret>
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=api.example.com,www.example.com
# DATABASE_URL=postgres://bymer:bymer@db:5432/bymer
# DJANGO_CORS_ALLOWED_ORIGINS=https://www.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://www.example.com,https://api.example.com
# PUBLIC_WEBSITE_BASE_URL=https://www.example.com
# ADMIN_NOTIFICATION_EMAILS=ops@example.com
# DJANGO_SECURE_SSL_REDIRECT=False
