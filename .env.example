# Local: copy to .env. Production: set all values on the server (see docs/DEPLOYMENT.md).

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Empty = SQLite (local only). Production example:
# DATABASE_URL=postgres://user:password@127.0.0.1:5432/bymer
DATABASE_URL=
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
